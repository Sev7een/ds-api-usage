{
  "name": "dsh-plugin-ds-api-usage",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: real-time DeepSeek API balance and usage timeline (cost / tokens / request count), rendered in a settings page.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "deepseek",
    "api-usage",
    "balance"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/bundle.js",
    "test": "node --test test/*.test.mjs",
    "update:pricing": "node .github/scripts/update-pricing.mjs --apply"
  },
  "engines": {
    "node": ">=20"
  }
}
